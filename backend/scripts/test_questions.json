{
  "test_set_name": "AcmeDesk RAG Quality Evaluation - Initial Test Set",
  "version": "1.0",
  "description": "Test questions covering various aspects of AcmeDesk documentation for RAG quality evaluation",
  "questions": [
    {
      "id": "Q001",
      "category": "factual",
      "question": "What is AcmeDesk?",
      "expected_topics": ["customer support platform", "ticket management", "AI chatbot", "analytics"],
      "expected_documents": ["getting-started.md", "faq.html"]
    },
    {
      "id": "Q002",
      "category": "factual",
      "question": "What are the pricing plans for AcmeDesk?",
