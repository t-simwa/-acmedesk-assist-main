# =============================================================================
# AcmeDesk Assist - Backend Environment Variables
# =============================================================================
# Copy this file to `.env` and fill in your actual values.
# NEVER commit `.env` files to version control - they are already in .gitignore
# =============================================================================

# -----------------------------------------------------------------------------
# Core Service Configuration
# -----------------------------------------------------------------------------
APP_NAME=AcmeDesk Assist Backend
ENVIRONMENT=development
FRONTEND_ORIGIN=http://localhost:5173

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# SQLite (default for development)
DATABASE_URL=sqlite:///./data/acmedesk.db

# PostgreSQL (recommended for production)
# DATABASE_URL=postgresql://user:password@localhost:5432/acmedesk

# -----------------------------------------------------------------------------
# Vector Database Configuration
# -----------------------------------------------------------------------------
# ChromaDB persistence directory (default: in-memory if not set)
VECTOR_STORE_PERSIST_DIR=./data/vector_db
VECTOR_COLLECTION_NAME=acmedesk_documents

# -----------------------------------------------------------------------------
# LLM Configuration (LiteLLM supports OpenAI, Ollama, Anthropic, etc.)
# -----------------------------------------------------------------------------
# OpenAI API Key (get from https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-your-openai-api-key

# Alternative: Ollama Cloud API Key
OLLAMA_API_KEY=your-ollama-cloud-api-key

# LLM Model (supported: gpt-4o, gpt-3.5-turbo, ollama/llama3.1, anthropic/claude-3, etc.)
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1000

# LLM Base URL (for self-hosted models)
# For Ollama Cloud: https://api.ollama.com
# For local Ollama: http://localhost:11434
# LLM_BASE_URL=https://api.ollama.com

# -----------------------------------------------------------------------------
# Embedding Configuration
# -----------------------------------------------------------------------------
# Sentence Transformers (default - runs locally, free)
EMBEDDING_MODEL=all-MiniLM-L6-v2
USE_OPENAI_EMBEDDINGS=false

# Or use OpenAI embeddings (requires OPENAI_API_KEY)
# USE_OPENAI_EMBEDDINGS=true

# -----------------------------------------------------------------------------
# Retrieval Configuration
# -----------------------------------------------------------------------------
RETRIEVAL_TOP_K=5
RETRIEVAL_USE_HYBRID_SEARCH=true
RETRIEVAL_HYBRID_SEMANTIC_WEIGHT=0.7
RETRIEVAL_HYBRID_KEYWORD_WEIGHT=0.3
RETRIEVAL_USE_RERANKING=false

# -----------------------------------------------------------------------------
# Authentication & JWT Configuration
# -----------------------------------------------------------------------------
# Generate a secure secret key: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your-secure-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_REMEMBER_ME_EXPIRE_DAYS=30

# -----------------------------------------------------------------------------
# Email Configuration (Resend)
# -----------------------------------------------------------------------------
# Get your API key from https://resend.com/dashboard/api-keys
# For development, you can use the default "onboarding@resend.dev" sender
# For production, verify your own domain in Resend dashboard
RESEND_API_KEY=re_your_api_key_here

# -----------------------------------------------------------------------------
# Email/SMTP Configuration (deprecated - use Resend above)
# -----------------------------------------------------------------------------
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=your-smtp-username
# SMTP_PASSWORD=your-smtp-password
# SMTP_USE_TLS=true
# For production, verify your domain in Resend and use it here
SMTP_FROM_EMAIL=noreply@simca-agencies.com
# SMTP_FROM_NAME=AcmeDesk Assist

# -----------------------------------------------------------------------------
# Email Channel (IMAP - receive emails)
# -----------------------------------------------------------------------------
EMAIL_CHANNEL_ENABLED=false
EMAIL_IMAP_HOST=imap.example.com
EMAIL_IMAP_PORT=993
EMAIL_IMAP_USERNAME=your-imap-username
EMAIL_IMAP_PASSWORD=your-imap-password
EMAIL_IMAP_USE_SSL=true
EMAIL_IMAP_MAILBOX=INBOX

# -----------------------------------------------------------------------------
# SMS Channel Configuration
# -----------------------------------------------------------------------------
SMS_CHANNEL_ENABLED=false
# SMS_DEFAULT_FROM_NUMBER=+15551234567
# SMS_OUTBOUND_WEBHOOK_URL=https://your-webhook.com/sms
# SMS_OUTBOUND_WEBHOOK_TOKEN=your-webhook-token

# -----------------------------------------------------------------------------
# WhatsApp Channel Configuration
# -----------------------------------------------------------------------------
WHATSAPP_CHANNEL_ENABLED=false
# WHATSAPP_DEFAULT_FROM_NUMBER=+15551234567
# WHATSAPP_OUTBOUND_WEBHOOK_URL=https://your-webhook.com/whatsapp
# WHATSAPP_OUTBOUND_WEBHOOK_TOKEN=your-webhook-token

# -----------------------------------------------------------------------------
# Facebook Messenger Channel Configuration
# -----------------------------------------------------------------------------
MESSENGER_CHANNEL_ENABLED=false
# MESSENGER_PAGE_ID=your-facebook-page-id
# MESSENGER_OUTBOUND_WEBHOOK_URL=https://your-webhook.com/messenger
# MESSENGER_OUTBOUND_WEBHOOK_TOKEN=your-webhook-token

# -----------------------------------------------------------------------------
# Twitter/X Channel Configuration
# -----------------------------------------------------------------------------
TWITTER_CHANNEL_ENABLED=false
# TWITTER_ACCOUNT_ID=your-twitter-account-id
# TWITTER_OUTBOUND_WEBHOOK_URL=https://your-webhook.com/twitter
# TWITTER_OUTBOUND_WEBHOOK_TOKEN=your-webhook-token
